{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "market-web",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-port",
        "8384"
      ],
      "cwd": "packages/apps/market_app",
      "port": 8384
    },
    {
      "name": "allure-android",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4041",
        "--directory",
        "allure-report-android"
      ],
      "port": 4041
    },
    {
      "name": "allure-web",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4042",
        "--directory",
        "allure-report-web"
      ],
      "port": 4042
    }
  ]
}
