# Dart / Flutter
.dart_tool/
.packages
build/
# Generated by `flutter pub get`, and it says so in its own first field. It
# records absolute paths into the pub cache of whoever ran it, so committing it
# means committing one machine's layout. CI regenerates all of them in `melos
# bs`, so a committed copy is overwritten on every run and never read.
.flutter-plugins-dependencies
pubspec.lock
pubspec_overrides.yaml
*.iml
.idea/

# Android
packages/apps/market_app/android/.gradle/
packages/apps/market_app/android/local.properties
packages/apps/market_app/android/app/debug/
packages/apps/market_app/android/app/profile/
packages/apps/market_app/android/app/release/

# iOS
packages/apps/market_app/ios/Pods/
packages/apps/market_app/ios/.symlinks/
packages/apps/market_app/ios/Flutter/Flutter.framework
packages/apps/market_app/ios/Flutter/Generated.xcconfig
packages/apps/market_app/ios/Flutter/flutter_export_environment.sh

# macOS
.DS_Store

# Patrol / Playwright
packages/apps/market_app/node_modules/
packages/apps/market_app/test_bundle.dart
packages/apps/market_app/patrol_test/test_bundle.dart

# Where `patrol test` writes when it is called by hand rather than through
# `run_web.sh`, which redirects both with `--web-report-dir` and
# `--web-results-dir`. The script's own runs land under `build/e2e/`, already
# ignored — these two only appear when someone debugs the CLI directly, which
# is a normal thing to do and should not dirty `git status`.
packages/apps/market_app/test-results/
packages/apps/market_app/playwright-report/

# Everything an E2E run generates — Playwright results, logcat, Allure results
# and report — lives under `build/e2e/<platform>/`, already ignored by the
# `build/` rule above. One root instead of four scattered paths: that way the
# cleanup cannot forget anything, which is exactly how `test-results/` went
# undeleted for months.
packages/sqa_l/tool/sqa_reporter/node_modules/
